<?xml version="1.0" encoding="utf-8"?>
<in.appoholics.the3s.SquareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/card_view_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/background_cell_rounded_coreners"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <ImageView
            android:id="@+id/category_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_home_filled"
            app:tint="#2C3E50"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/category_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Category"
            android:textColor="#2C3E50"
            android:textSize="14sp" />

    </LinearLayout>

</in.appoholics.the3s.SquareLinearLayout>