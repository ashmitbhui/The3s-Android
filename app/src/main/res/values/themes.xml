<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.The3S" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowOptOutEdgeToEdgeEnforcement" tools:ignore="NewApi">true</item>
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primaryColor</item>
        <item name="colorPrimaryVariant">@color/primaryDark</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">#2A9070</item>
        <item name="colorSecondaryVariant">#1F7A5E</item>
        <item name="colorOnSecondary">@color/white</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
        <!-- Customize your theme here. -->
    </style>

    <style name="MinimalisticDotIndicator" parent="Widget.MaterialComponents.TabLayout">
        <item name="tabIndicatorHeight">0dp</item>

        <item name="tabBackground">@drawable/tab_selector</item>

        <item name="tabPaddingStart">3dp</item>
        <item name="tabPaddingEnd">3dp</item>

        <item name="tabRippleColor">@null</item>
    </style>
</resources>