<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="#E1E8E3"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/asset_thumb"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#F1F4F2"
                android:contentDescription="Asset preview"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <ImageView
                android:id="@+id/asset_play_icon"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="center"
                android:contentDescription="Play"
                android:src="@drawable/ic_play_circle"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/asset_type_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="8dp"
                android:background="@drawable/bg_type_badge"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="VIDEO"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/asset_share"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_share_circle"
                android:contentDescription="Share"
                android:padding="8dp"
                android:src="@drawable/ic_share"
                app:tint="@color/primaryColor" />
        </FrameLayout>

        <TextView
            android:id="@+id/asset_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:padding="12dp"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            tools:text="Diwali Campaign 2026" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
