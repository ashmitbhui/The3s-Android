<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bodyLight"
    android:orientation="vertical"
    tools:context=".CategoryDetail">

    <LinearLayout
        android:id="@+id/category_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Immersive header: back + category title + login -->
        <LinearLayout
            android:id="@+id/header_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingTop="12dp"
            android:paddingEnd="14dp"
            android:paddingBottom="16dp">

            <ImageButton
                android:id="@+id/back_button"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_back_circle"
                android:contentDescription="Back"
                android:padding="7dp"
                android:src="@drawable/ic_back"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/category_detail_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="Category Name"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold"
                tools:text="Table Clocks" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/login"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_login_pill_on_green"
                android:minWidth="80dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="Login"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Sort / filter chips -->
        <LinearLayout
            android:id="@+id/catalogue_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:background="@drawable/bg_catalogue_bar"
            android:visibility="gone">

            <ImageView
                android:id="@+id/catalogue_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:src="@drawable/ic_pdf_doc"
                android:contentDescription="Catalogue" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category catalogue"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:id="@+id/catalogue_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:textColor="@color/captionMuted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/catalogue_view"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="View"
                android:textAllCaps="false"
                android:textSize="13sp"
                app:cornerRadius="16dp" />

            <ImageButton
                android:id="@+id/catalogue_share"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_catalogue_share"
                android:src="@drawable/ic_share"
                app:tint="@color/white"
                android:contentDescription="Share catalogue" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sort_filter_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bodyLight"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="2dp">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/sort_button"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_light"
                android:drawableStart="@drawable/ic_sort"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="Sort"
                android:textAllCaps="false"
                android:textColor="@color/chipText"
                android:textSize="13sp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/filter_button"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_chip_light"
                android:drawableStart="@drawable/ic_filter"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:stateListAnimator="@null"
                android:text="Filter"
                android:textAllCaps="false"
                android:textColor="@color/chipText"
                android:textSize="13sp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/product_recycler_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/bodyLight"
            android:clipToPadding="false"
            android:padding="8dp"
            android:paddingBottom="80dp"
            app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
            app:spanCount="2"
            tools:listitem="@layout/item_product_card" />

    </LinearLayout>

    <!-- Floating share pill -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/share_selected_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="16dp"
        android:paddingStart="26dp"
        android:paddingTop="12dp"
        android:paddingEnd="26dp"
        android:paddingBottom="12dp"
        android:text="Share Selected (0)"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:visibility="gone"
        app:backgroundTint="@color/primaryColor"
        app:cornerRadius="24dp" />

</RelativeLayout>
