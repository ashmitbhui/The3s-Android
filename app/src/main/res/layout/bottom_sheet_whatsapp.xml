<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:contentDescription="Drag handle"
        android:src="@drawable/drag_handle_shape" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="sans-serif-medium"
        android:text="WhatsApp"
        android:textColor="@color/textPrimary"
        android:textSize="19sp"
        android:textStyle="bold" />

    <!-- Broadcast channels -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:text="Follow our channels"
        android:textAllCaps="true"
        android:textColor="@color/captionMuted"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/option_channel_trophyverse"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="📢  TrophyVerse — Ready Stocks"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="Ready-stock trophies — latest designs, quick branding, share-ready images"
            android:textColor="@color/captionMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/option_channel_branding"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="12dp"
        android:paddingEnd="20dp"
        android:paddingBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="📢  Branding Media"
            android:textColor="@color/textPrimary"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:text="Branding and marketing media updates"
            android:textColor="@color/captionMuted"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:id="@+id/chats_divider"
        android:layout_height="1dp"
        android:layout_marginStart="20dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="20dp"
        android:background="@color/divider" />

    <!-- Direct enquiries -->
    <TextView
        android:id="@+id/chats_caption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.1"
        android:text="Chat with us"
        android:textAllCaps="true"
        android:textColor="@color/captionMuted"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/option_3s_enquiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="13dp"
        android:text="💬  3S Enquiry"
        android:textColor="@color/textPrimary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/option_verbose_enquiry"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="13dp"
        android:text="💬  Verbose Enquiry"
        android:textColor="@color/textPrimary"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/option_auto_response"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:fontFamily="sans-serif-medium"
        android:paddingStart="20dp"
        android:paddingTop="13dp"
        android:paddingEnd="20dp"
        android:paddingBottom="13dp"
        android:text="🤖  Auto Response System"
        android:textColor="@color/textPrimary"
        android:textSize="15sp" />

</LinearLayout>
