<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/dialog_background">

    <TextView
        android:id="@+id/share_pricing_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share product"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="16dp"
        android:text="Prices are visible to you as a dealer. Choose what your customer sees."
        android:textSize="13sp"
        android:textColor="#6B7A72" />

    <RadioGroup
        android:id="@+id/share_pricing_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <RadioButton
            android:id="@+id/radio_list_price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="With list price"
            android:textSize="16sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:layout_marginBottom="12dp" />

        <RadioButton
            android:id="@+id/radio_add_margin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Add my margin"
            android:textSize="16sp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp" />
    </RadioGroup>

    <LinearLayout
        android:id="@+id/margin_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/margin_type_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/radio_margin_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="%" />

            <RadioButton
                android:id="@+id/radio_margin_fixed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹" />
        </RadioGroup>

        <EditText
            android:id="@+id/margin_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:hint="e.g. 15"
            android:inputType="numberDecimal"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical">

        <Button
            android:id="@+id/share_no_price_button"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Share without price"
            android:textColor="#6B7A72" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/share_continue_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Continue" />
    </LinearLayout>

</LinearLayout>
